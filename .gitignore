# Build outputs
[Bb]in/
[Oo]bj/
publish/
out/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
logs/
*.log

# Runtime secrets & keys — never commit
**/App_Data/keys/
**/appsettings.*.local.json
*.pfx
*.key

# User-uploaded content (photos, documents) — not source, not meant for version control
**/wwwroot/uploads/

# Node (Tailwind CLI build tooling)
node_modules/
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Confidential business documents — kept local, not versioned
Cahier des Charges ISPS CIT.docx

# Test results
[Tt]est[Rr]esult*/
*.trx
