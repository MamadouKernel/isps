@model NonConformity
@{
    ViewData["Title"] = "Déclarer une non-conformité";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">❗ Déclarer une non-conformité</h1>
</div>

<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2"><label asp-for="Title" class="block text-sm mb-1"></label><input asp-for="Title" required /></div>
        <div><label asp-for="Source" class="block text-sm mb-1"></label><select asp-for="Source" asp-items="Html.GetEnumSelectList<NonConformitySource>()"></select></div>
        <div><label asp-for="IdentifiedAt" class="block text-sm mb-1"></label><input asp-for="IdentifiedAt" type="date" required /></div>
        <div><label asp-for="Owner" class="block text-sm mb-1"></label><input asp-for="Owner" placeholder="Nom du responsable" /></div>
        <div><label asp-for="DueDate" class="block text-sm mb-1"></label><input asp-for="DueDate" type="date" /></div>
        <div class="md:col-span-2"><label asp-for="Description" class="block text-sm mb-1"></label><textarea asp-for="Description" rows="3" required></textarea></div>
        <div class="md:col-span-2"><label asp-for="CorrectiveAction" class="block text-sm mb-1"></label><textarea asp-for="CorrectiveAction" rows="3" placeholder="Plan d'action proposé"></textarea></div>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary text-center">Annuler</a>
        <button type="submit" class="btn-primary">✓ Enregistrer</button>
    </div>
</form>
