@model NonConformity
@{
    ViewData["Title"] = Model.Reference;
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string StatusClass(NonConformityStatus s) => s switch
    {
        NonConformityStatus.Identifiee => "badge-rouge",
        NonConformityStatus.EnTraitement => "badge-ambre",
        NonConformityStatus.Levee => "badge-vert",
        _ => "badge-bleu"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div>
        <div class="text-xs text-slate-400 uppercase tracking-wider">Référence</div>
        <div class="flex items-center gap-3 mt-1 flex-wrap">
            <span class="mono text-2xl text-cyan-400 font-bold">@Model.Reference</span>
            <span class="@StatusClass(Model.Status) px-2 py-1 rounded text-xs">@Model.Status</span>
        </div>
        <h1 class="text-lg sm:text-xl text-white font-semibold mt-2">@Model.Title</h1>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-secondary text-sm">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "NonConformities",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Déplacer vers la corbeille ?"
            })
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card p-5 lg:col-span-2 space-y-4">
        <section>
            <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Description</h3>
            <p class="whitespace-pre-wrap text-slate-200">@Model.Description</p>
        </section>
        @if (!string.IsNullOrEmpty(Model.CorrectiveAction))
        {
            <section>
                <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Action corrective (CAPA)</h3>
                <p class="whitespace-pre-wrap text-slate-200">@Model.CorrectiveAction</p>
            </section>
        }
        @if (!string.IsNullOrEmpty(Model.ClosureEvidence))
        {
            <section>
                <h3 class="text-sm uppercase tracking-wider text-emerald-400 mb-2">✓ Preuve de clôture</h3>
                <p class="whitespace-pre-wrap text-slate-200">@Model.ClosureEvidence</p>
            </section>
        }

        @if (canEdit && Model.Status != NonConformityStatus.Levee && Model.Status != NonConformityStatus.Rejetee)
        {
            <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="border-t border-slate-700 pt-4">
                @Html.AntiForgeryToken()
                <label class="block text-sm mb-1 text-emerald-400">Lever la non-conformité (preuve obligatoire)</label>
                <textarea name="evidence" rows="3" required placeholder="Action réalisée le …, vérification par …, document joint …"></textarea>
                <button type="submit" class="btn-primary mt-2">✓ Lever la NC</button>
            </form>
        }
    </div>

    <aside class="card p-5">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-3">Informations</h3>
        <dl class="text-sm space-y-2">
            <div><dt class="text-slate-500 text-xs">Source</dt><dd class="text-slate-200">@Model.Source</dd></div>
            <div><dt class="text-slate-500 text-xs">Identifiée le</dt><dd class="text-slate-200 mono">@Model.IdentifiedAt.ToString("dd/MM/yyyy")</dd></div>
            <div><dt class="text-slate-500 text-xs">Échéance</dt><dd class="text-slate-200 mono">@(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
            <div><dt class="text-slate-500 text-xs">Responsable</dt><dd class="text-slate-200">@(string.IsNullOrEmpty(Model.Owner) ? "—" : Model.Owner)</dd></div>
            @if (Model.ClosedAt is not null)
            {
                <div><dt class="text-slate-500 text-xs">Levée le</dt><dd class="text-emerald-400 mono">@Model.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
            }
        </dl>
    </aside>
</div>
