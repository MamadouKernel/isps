@model IReadOnlyList<NonConformity>
@{
    ViewData["Title"] = "Non-conformités";
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string StatusClass(NonConformityStatus s) => s switch
    {
        NonConformityStatus.Identifiee => "badge-rouge",
        NonConformityStatus.EnTraitement => "badge-ambre",
        NonConformityStatus.Levee => "badge-vert",
        _ => "badge-bleu"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">❗ Non-conformités & actions correctives</h1>
        <p class="text-xs sm:text-sm text-slate-400">Registre CAPA (Corrective and Preventive Actions)</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Déclarer une NC</a>
    }
</div>

<div class="card p-3 sm:p-4">
    @if (Model.Count == 0)
    {
        <p class="text-center text-slate-400 py-8">Aucune non-conformité enregistrée.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="w-full text-sm">
                <thead class="text-xs text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2 whitespace-nowrap">Référence</th>
                        <th class="text-left p-2">Intitulé</th>
                        <th class="text-left p-2">Source</th>
                        <th class="text-left p-2">Responsable</th>
                        <th class="text-left p-2 whitespace-nowrap">Échéance</th>
                        <th class="text-center p-2">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nc in Model)
                    {
                        <tr class="border-b border-slate-800 hover:bg-slate-800/40 cursor-pointer"
                            data-href="@Url.Action("Details", new { id = nc.Id })">
                            <td class="p-2 mono text-cyan-400">@nc.Reference</td>
                            <td class="p-2 text-slate-200">@nc.Title</td>
                            <td class="p-2 text-slate-400">@nc.Source</td>
                            <td class="p-2 text-slate-400">@nc.Owner</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@(nc.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="p-2 text-center"><span class="@StatusClass(nc.Status) px-2 py-0.5 rounded text-xs">@nc.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
