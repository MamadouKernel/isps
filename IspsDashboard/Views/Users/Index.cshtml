@model List<UserListItem>
@{
    ViewData["Title"] = "Utilisateurs";
}
<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4 sm:mb-6">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">👥 Utilisateurs</h1>
        <p class="text-xs sm:text-sm text-slate-400">Gestion des comptes et rôles</p>
    </div>
    <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Nouvel utilisateur</a>
</div>

<div class="card p-3 sm:p-4">
    <p class="text-xs text-slate-500 sm:hidden mb-2">↔️ Faites défiler horizontalement</p>
    <div class="table-wrap">
        <table class="w-full text-xs sm:text-sm">
            <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                <tr>
                    <th class="text-left p-2">Email</th>
                    <th class="text-left p-2">Nom complet</th>
                    <th class="text-left p-2">Rôle</th>
                    <th class="text-left p-2 whitespace-nowrap">Créé le</th>
                    <th class="text-right p-2">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="border-b border-slate-800">
                        <td class="p-2 text-cyan-300 break-all">@u.Email</td>
                        <td class="p-2 text-slate-200">@u.FullName</td>
                        <td class="p-2"><span class="badge-vert px-2 py-0.5 rounded text-xs whitespace-nowrap">@u.Role</span></td>
                        <td class="p-2 text-slate-500 mono whitespace-nowrap">@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="p-2 text-right whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn-secondary text-xs" title="Détails">👁️</a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn-secondary text-xs" title="Modifier">✏️</a>
                            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                            {
                                Controller = "Users",
                                RouteValues = { ["id"] = u.Id },
                                ConfirmMessage = $"Supprimer {u.Email} ?",
                                ButtonLabel = "Supprimer",
                                ButtonClass = "btn-danger text-xs"
                            })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
