@model ShiftBriefing
@{
    ViewData["Title"] = "Saisir un briefing";
}
<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">📋 Saisir un briefing de prise de poste</h1>
    <p class="text-xs sm:text-sm text-slate-400">Toute information utile à l'équipe entrante (événements, alertes, consignes spécifiques).</p>
</div>

<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div><label asp-for="ShiftDate" class="block text-sm mb-1"></label><input asp-for="ShiftDate" type="date" required /></div>
        <div><label asp-for="Slot" class="block text-sm mb-1"></label><select asp-for="Slot" asp-items="Html.GetEnumSelectList<ShiftSlot>()"></select></div>
        <div><label asp-for="CurrentMarsecLevel" class="block text-sm mb-1"></label><input asp-for="CurrentMarsecLevel" type="number" min="1" max="3" /></div>
        <div><label asp-for="OutgoingAgent" class="block text-sm mb-1"></label><input asp-for="OutgoingAgent" required /></div>
        <div><label asp-for="IncomingAgent" class="block text-sm mb-1"></label><input asp-for="IncomingAgent" /></div>
        <div class="md:col-span-3"><label asp-for="EventsSummary" class="block text-sm mb-1"></label><textarea asp-for="EventsSummary" rows="4" placeholder="Que s'est-il passé pendant ma vacation ? incidents, alarmes, visiteurs sortis, etc."></textarea></div>
        <div class="md:col-span-3"><label asp-for="AttentionPoints" class="block text-sm mb-1"></label><textarea asp-for="AttentionPoints" rows="3" placeholder="Sur quoi mon collègue doit être particulièrement vigilant ?"></textarea></div>
        <div class="md:col-span-3"><label asp-for="StandingOrders" class="block text-sm mb-1"></label><textarea asp-for="StandingOrders" rows="3" placeholder="Ordres spécifiques de la hiérarchie / consignes du jour"></textarea></div>
    </div>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Enregistrer le briefing</button>
    </div>
</form>
