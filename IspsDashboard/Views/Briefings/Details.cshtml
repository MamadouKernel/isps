@model ShiftBriefing
@{
    ViewData["Title"] = $"Briefing du {Model.ShiftDate:dd/MM/yyyy}";
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string SlotLabel(ShiftSlot s) => s switch
    {
        ShiftSlot.Matin => "🌅 Matin (06h-14h)",
        ShiftSlot.ApresMidi => "☀️ Après-midi (14h-22h)",
        _ => "🌙 Nuit (22h-06h)"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div>
        <div class="text-xs text-slate-400 uppercase tracking-wider">Briefing de prise de poste</div>
        <div class="flex items-center gap-3 mt-1 flex-wrap">
            <span class="mono text-xl text-cyan-400 font-bold">@Model.ShiftDate.ToString("dd/MM/yyyy")</span>
            <span class="badge-bleu text-xs px-2 py-1 rounded">@SlotLabel(Model.Slot)</span>
            @if (Model.AcknowledgedByIncoming)
            {
                <span class="badge-vert text-xs px-2 py-1 rounded">✓ Pris en compte</span>
            }
        </div>
        <h1 class="text-lg sm:text-xl text-white font-semibold mt-2">@Model.OutgoingAgent → @Model.IncomingAgent</h1>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-secondary text-sm">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "Briefings",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Déplacer ce briefing vers la corbeille ?"
            })
        }
    </div>
</div>

<div class="card p-5 space-y-4">
    <dl class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
        <div><dt class="text-slate-500 text-xs uppercase">Niveau MARSEC</dt><dd class="badge-bleu inline-block text-xs px-2 py-0.5 rounded mt-1">N°@Model.CurrentMarsecLevel</dd></div>
        <div><dt class="text-slate-500 text-xs uppercase">Sortant</dt><dd class="text-slate-200">@Model.OutgoingAgent</dd></div>
        <div><dt class="text-slate-500 text-xs uppercase">Entrant</dt><dd class="text-slate-200">@Model.IncomingAgent</dd></div>
    </dl>
    @if (!string.IsNullOrEmpty(Model.EventsSummary))
    {
        <div class="pt-3 border-t border-slate-700">
            <div class="text-xs uppercase text-cyan-400 mb-1">Événements de la vacation</div>
            <p class="text-sm text-slate-200 whitespace-pre-wrap">@Model.EventsSummary</p>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.AttentionPoints))
    {
        <div class="pt-3 border-t border-slate-700">
            <div class="text-xs uppercase text-amber-400 mb-1">⚠ Points d'attention</div>
            <p class="text-sm text-slate-200 whitespace-pre-wrap">@Model.AttentionPoints</p>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.StandingOrders))
    {
        <div class="pt-3 border-t border-slate-700">
            <div class="text-xs uppercase text-cyan-400 mb-1">📜 Consignes du jour</div>
            <p class="text-sm text-slate-200 whitespace-pre-wrap">@Model.StandingOrders</p>
        </div>
    }
    @if (!Model.AcknowledgedByIncoming && canEdit)
    {
        <form asp-action="Acknowledge" asp-route-id="@Model.Id" method="post" class="pt-3 border-t border-slate-700">
            @Html.AntiForgeryToken()
            <button class="btn-primary text-xs">✓ Marquer comme pris en compte</button>
        </form>
    }
</div>
