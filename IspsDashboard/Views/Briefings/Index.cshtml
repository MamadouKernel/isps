@{
    ViewData["Title"] = "Briefings de prise de poste";
    var latest = ViewBag.Latest as ShiftBriefing;
    var recent = ViewBag.Recent as IReadOnlyList<ShiftBriefing> ?? new List<ShiftBriefing>();
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string SlotLabel(ShiftSlot s) => s switch
    {
        ShiftSlot.Matin => "🌅 Matin (06h-14h)",
        ShiftSlot.ApresMidi => "☀️ Après-midi (14h-22h)",
        _ => "🌙 Nuit (22h-06h)"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">📋 Briefings de prise de poste</h1>
        <p class="text-xs sm:text-sm text-slate-400">Passation entre vacations — traçabilité ISPS Part B § 18.4</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Saisir un briefing</a>
    }
</div>

@if (latest is not null)
{
    <section class="card p-5 mb-5 border-l-4 @(latest.AcknowledgedByIncoming ? "border-emerald-500" : "border-amber-500")">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <h3 class="text-lg font-semibold text-white">Dernier briefing — @latest.ShiftDate.ToString("dd/MM/yyyy")</h3>
            <div class="flex items-center gap-2 flex-wrap">
                <span class="badge-bleu text-xs px-2 py-0.5 rounded">@SlotLabel(latest.Slot)</span>
                @if (latest.AcknowledgedByIncoming)
                {
                    <span class="badge-vert text-xs px-2 py-0.5 rounded">✓ Pris en compte</span>
                }
                else
                {
                    <form asp-action="Acknowledge" asp-route-id="@latest.Id" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button class="btn-primary text-xs">✓ Marquer comme pris en compte</button>
                    </form>
                }
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div><span class="text-slate-500 text-xs uppercase">Sortant :</span> <span class="text-slate-200">@latest.OutgoingAgent</span></div>
            <div><span class="text-slate-500 text-xs uppercase">Entrant :</span> <span class="text-slate-200">@latest.IncomingAgent</span></div>
            <div><span class="text-slate-500 text-xs uppercase">Niveau MARSEC :</span> <span class="badge-bleu text-xs px-2 py-0.5 rounded">N°@latest.CurrentMarsecLevel</span></div>
        </div>
        @if (!string.IsNullOrEmpty(latest.EventsSummary))
        {
            <div class="mt-3 pt-3 border-t border-slate-700">
                <div class="text-xs uppercase text-cyan-400 mb-1">Événements de la vacation</div>
                <p class="text-sm text-slate-200 whitespace-pre-wrap">@latest.EventsSummary</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(latest.AttentionPoints))
        {
            <div class="mt-3 pt-3 border-t border-slate-700">
                <div class="text-xs uppercase text-amber-400 mb-1">⚠ Points d'attention</div>
                <p class="text-sm text-slate-200 whitespace-pre-wrap">@latest.AttentionPoints</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(latest.StandingOrders))
        {
            <div class="mt-3 pt-3 border-t border-slate-700">
                <div class="text-xs uppercase text-cyan-400 mb-1">📜 Consignes du jour</div>
                <p class="text-sm text-slate-200 whitespace-pre-wrap">@latest.StandingOrders</p>
            </div>
        }
    </section>
}

<section class="card p-4 sm:p-5">
    <h3 class="font-semibold text-cyan-400 text-sm uppercase mb-3">📜 Historique (@recent.Count)</h3>
    @if (recent.Count == 0)
    {
        <p class="text-slate-400 text-sm">Aucun briefing enregistré.</p>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var b in recent)
            {
                <details class="border border-slate-700 rounded p-3">
                    <summary class="cursor-pointer flex justify-between items-start flex-wrap gap-2">
                        <div>
                            <span class="mono text-slate-400 text-xs">@b.ShiftDate.ToString("dd/MM/yyyy")</span>
                            <span class="ml-2 text-xs text-slate-500">@SlotLabel(b.Slot)</span>
                            <span class="ml-2 text-sm text-slate-200">@b.OutgoingAgent → @b.IncomingAgent</span>
                        </div>
                        @if (b.AcknowledgedByIncoming)
                        {
                            <span class="badge-vert text-[10px] px-2 py-0.5 rounded">✓ ack</span>
                        }
                    </summary>
                    <div class="mt-3 text-sm space-y-2">
                        @if (!string.IsNullOrEmpty(b.EventsSummary)) { <div><span class="text-xs text-cyan-400 uppercase">Événements :</span><p class="whitespace-pre-wrap text-slate-300 text-xs mt-1">@b.EventsSummary</p></div> }
                        @if (!string.IsNullOrEmpty(b.AttentionPoints)) { <div><span class="text-xs text-amber-400 uppercase">Points d'attention :</span><p class="whitespace-pre-wrap text-slate-300 text-xs mt-1">@b.AttentionPoints</p></div> }
                        @if (!string.IsNullOrEmpty(b.StandingOrders)) { <div><span class="text-xs text-cyan-400 uppercase">Consignes :</span><p class="whitespace-pre-wrap text-slate-300 text-xs mt-1">@b.StandingOrders</p></div> }
                        <div class="flex items-center gap-2 pt-2 border-t border-slate-700 mt-2">
                            <a asp-action="Details" asp-route-id="@b.Id" class="btn-secondary text-xs">👁️ Détails</a>
                        </div>
                        @if (canEdit)
                        {
                            <div class="flex items-center gap-2 pt-2 mt-2">
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn-secondary text-xs">✏️ Modifier</a>
                                @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                                {
                                    Controller = "Briefings",
                                    RouteValues = { ["id"] = b.Id.ToString() },
                                    ConfirmMessage = "Déplacer ce briefing vers la corbeille ?",
                                    ButtonClass = "btn-danger text-xs"
                                })
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    }
</section>
