@model ShiftBriefing
@{ ViewData["Title"] = "Modifier le briefing"; }
<div class="mb-5"><h1 class="text-xl sm:text-2xl font-bold text-white">✏️ Briefing du @Model.ShiftDate.ToString("dd/MM/yyyy")</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div><label asp-for="ShiftDate" class="block text-sm mb-1"></label><input asp-for="ShiftDate" type="date" /></div>
        <div><label asp-for="Slot" class="block text-sm mb-1"></label><select asp-for="Slot" asp-items="Html.GetEnumSelectList<IspsDashboard.Models.Enums.ShiftSlot>()"></select></div>
        <div><label asp-for="CurrentMarsecLevel" class="block text-sm mb-1"></label><input asp-for="CurrentMarsecLevel" type="number" min="1" max="3" /></div>
        <div><label asp-for="OutgoingAgent" class="block text-sm mb-1"></label><input asp-for="OutgoingAgent" /></div>
        <div><label asp-for="IncomingAgent" class="block text-sm mb-1"></label><input asp-for="IncomingAgent" /></div>
        <div class="md:col-span-3"><label asp-for="EventsSummary" class="block text-sm mb-1"></label><textarea asp-for="EventsSummary" rows="3"></textarea></div>
        <div class="md:col-span-3"><label asp-for="AttentionPoints" class="block text-sm mb-1"></label><textarea asp-for="AttentionPoints" rows="3"></textarea></div>
        <div class="md:col-span-3"><label asp-for="StandingOrders" class="block text-sm mb-1"></label><textarea asp-for="StandingOrders" rows="3"></textarea></div>
    </div>
    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Enregistrer</button>
    </div>
</form>
