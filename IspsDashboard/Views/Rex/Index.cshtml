@{
    ViewData["Title"] = "REX exercices";
    var recent = ViewBag.Recent as IReadOnlyList<ExerciseRex> ?? new List<ExerciseRex>();
    var exercises = ViewBag.Exercises as IReadOnlyList<Exercise> ?? new List<Exercise>();
    var exerciseIdsWithRex = recent.Select(r => r.ExerciseId).ToHashSet();
    bool canEditRex = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">📝 REX (Retours d'Expérience) post-exercices</h1>
    <p class="text-xs sm:text-sm text-slate-400">5 sections structurées par exercice — preuve auditable ISPS Part B § 18.6</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="card p-4 sm:p-5">
        <h3 class="font-semibold text-cyan-400 text-sm uppercase mb-3">Exercices récents</h3>
        <div class="space-y-2 max-h-[600px] overflow-y-auto">
            @foreach (var ex in exercises)
            {
                var hasRex = exerciseIdsWithRex.Contains(ex.Id);
                <a asp-action="@(canEditRex ? "Edit" : "Index")" asp-route-exerciseId="@ex.Id" class="block border @(hasRex ? "border-emerald-500/40" : "border-slate-700") rounded p-3 @(canEditRex ? "hover:border-cyan-400" : "cursor-default")">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div>
                            <div class="text-sm text-slate-200">@ex.Icon @ex.Name</div>
                            <div class="text-xs text-slate-500 mt-0.5 mono">@ex.PlannedDate.ToString("dd/MM/yyyy") · @ex.Responsible</div>
                        </div>
                        @if (hasRex)
                        {
                            <span class="badge-vert text-[10px] px-2 py-0.5 rounded">✓ REX rédigé</span>
                        }
                        else
                        {
                            <span class="badge-ambre text-[10px] px-2 py-0.5 rounded">REX manquant</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>

    <section class="card p-4 sm:p-5">
        <h3 class="font-semibold text-cyan-400 text-sm uppercase mb-3">📜 REX récents rédigés (@recent.Count)</h3>
        <div class="space-y-2 max-h-[600px] overflow-y-auto">
            @if (recent.Count == 0)
            {
                <p class="text-slate-400 text-sm">Aucun REX rédigé.</p>
            }
            @foreach (var r in recent)
            {
                <details class="border border-slate-700 rounded p-3">
                    <summary class="cursor-pointer flex items-center justify-between gap-2 flex-wrap">
                        <div class="text-sm text-slate-200">@r.Exercise?.Icon @r.Exercise?.Name</div>
                        <div class="text-[11px] text-slate-500 mono">@r.WrittenAt.ToLocalTime().ToString("dd/MM/yyyy") · @r.WrittenBy</div>
                    </summary>
                    <div class="mt-3 space-y-2 text-sm">
                        @if (!string.IsNullOrEmpty(r.Sequence)) { <div><span class="text-cyan-400 text-xs uppercase">Déroulé :</span><p class="text-slate-300 text-xs whitespace-pre-wrap mt-1">@r.Sequence</p></div> }
                        @if (!string.IsNullOrEmpty(r.PositivePoints)) { <div><span class="text-emerald-400 text-xs uppercase">Positif :</span><p class="text-slate-300 text-xs whitespace-pre-wrap mt-1">@r.PositivePoints</p></div> }
                        @if (!string.IsNullOrEmpty(r.ImprovementPoints)) { <div><span class="text-amber-400 text-xs uppercase">À améliorer :</span><p class="text-slate-300 text-xs whitespace-pre-wrap mt-1">@r.ImprovementPoints</p></div> }
                        @if (!string.IsNullOrEmpty(r.CorrectiveActions)) { <div><span class="text-cyan-400 text-xs uppercase">Actions correctives :</span><p class="text-slate-300 text-xs whitespace-pre-wrap mt-1">@r.CorrectiveActions</p></div> }
                        @if (!string.IsNullOrEmpty(r.FollowUp)) { <div><span class="text-cyan-400 text-xs uppercase">Suivi :</span><p class="text-slate-300 text-xs whitespace-pre-wrap mt-1">@r.FollowUp</p></div> }
                        @if (canEditRex)
                        {
                            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                            {
                                Controller = "Rex",
                                RouteValues = { ["id"] = r.Id.ToString() },
                                ConfirmMessage = "Déplacer ce REX vers la corbeille ?",
                                ButtonClass = "btn-danger text-xs",
                                FormClass = "pt-2 border-t border-slate-700 mt-2"
                            })
                        }
                    </div>
                </details>
            }
        </div>
    </section>
</div>
