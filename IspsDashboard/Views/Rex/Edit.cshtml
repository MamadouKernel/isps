@model ExerciseRex
@{
    ViewData["Title"] = "REX d'exercice";
    var ex = ViewBag.Exercise as Exercise;
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">📝 REX — @ex?.Icon @ex?.Name</h1>
    <p class="text-xs sm:text-sm text-slate-400">@ex?.PlannedDate.ToString("dd/MM/yyyy") · Responsable : @ex?.Responsible</p>
</div>

<form asp-action="Edit" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExerciseId" />
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="space-y-4">
        <div>
            <label asp-for="Sequence" class="block text-sm font-medium text-cyan-400 mb-1">1 · @Html.DisplayNameFor(m => m.Sequence)</label>
            <p class="text-xs text-slate-500 mb-1">Chronologie des actions : qui a fait quoi, quand, dans quelles conditions.</p>
            <textarea asp-for="Sequence" rows="5"></textarea>
        </div>
        <div>
            <label asp-for="PositivePoints" class="block text-sm font-medium text-emerald-400 mb-1">2 · @Html.DisplayNameFor(m => m.PositivePoints)</label>
            <p class="text-xs text-slate-500 mb-1">Ce qui a bien fonctionné, à pérenniser.</p>
            <textarea asp-for="PositivePoints" rows="4"></textarea>
        </div>
        <div>
            <label asp-for="ImprovementPoints" class="block text-sm font-medium text-amber-400 mb-1">3 · @Html.DisplayNameFor(m => m.ImprovementPoints)</label>
            <p class="text-xs text-slate-500 mb-1">Difficultés rencontrées, écarts par rapport au PFSP.</p>
            <textarea asp-for="ImprovementPoints" rows="4"></textarea>
        </div>
        <div>
            <label asp-for="CorrectiveActions" class="block text-sm font-medium text-cyan-400 mb-1">4 · @Html.DisplayNameFor(m => m.CorrectiveActions)</label>
            <p class="text-xs text-slate-500 mb-1">Décisions prises pour remédier aux écarts (formation, équipement, procédure).</p>
            <textarea asp-for="CorrectiveActions" rows="4"></textarea>
        </div>
        <div>
            <label asp-for="FollowUp" class="block text-sm font-medium text-cyan-400 mb-1">5 · @Html.DisplayNameFor(m => m.FollowUp)</label>
            <p class="text-xs text-slate-500 mb-1">Échéances de vérification, prochain exercice de validation.</p>
            <textarea asp-for="FollowUp" rows="4"></textarea>
        </div>
        <div>
            <label asp-for="WrittenBy" class="block text-sm mb-1"></label>
            <input asp-for="WrittenBy" placeholder="Nom du rédacteur" />
        </div>
    </div>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Enregistrer le REX</button>
    </div>
</form>
