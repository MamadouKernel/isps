@model Camera
@{
    ViewData["Title"] = Model.Code;
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string StatusClass(CameraStatus s) => s switch
    {
        CameraStatus.Operationnelle => "badge-vert",
        CameraStatus.EnMaintenance => "badge-ambre",
        CameraStatus.Defaillante => "badge-rouge",
        _ => "badge-rouge"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div>
        <div class="flex items-center gap-3 flex-wrap">
            <span class="mono text-2xl text-cyan-400 font-bold">@Model.Code</span>
            <span class="@StatusClass(Model.Status) text-xs px-2 py-1 rounded">@Model.Status</span>
        </div>
        <h1 class="text-lg sm:text-xl text-white font-semibold mt-2">@Model.Label</h1>
        <div class="text-xs text-slate-400 mt-1">@Model.Zone · @Model.Type · @Model.Model</div>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-secondary text-sm">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "Cameras",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Déplacer cette caméra vers la corbeille ?"
            })
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <aside class="card p-5 space-y-2">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Spécifications</h3>
        <dl class="text-sm space-y-2">
            <div><dt class="text-slate-500 text-xs">Adresse IP</dt><dd class="mono text-slate-200">@(string.IsNullOrEmpty(Model.IpAddress) ? "—" : Model.IpAddress)</dd></div>
            <div><dt class="text-slate-500 text-xs">Marque/Modèle</dt><dd class="text-slate-200">@(string.IsNullOrEmpty(Model.Model) ? "—" : Model.Model)</dd></div>
            <div><dt class="text-slate-500 text-xs">Dernière vérification</dt><dd class="text-slate-200 mono">@(Model.LastCheckedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Jamais")</dd></div>
            <div><dt class="text-slate-500 text-xs">Par</dt><dd class="text-slate-200">@(string.IsNullOrEmpty(Model.LastCheckedBy) ? "—" : Model.LastCheckedBy)</dd></div>
        </dl>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="border-t border-slate-700 pt-3 mt-3">
                <div class="text-xs text-slate-500 mb-1">Notes / Angles morts</div>
                <p class="text-sm text-slate-300 whitespace-pre-wrap">@Model.Notes</p>
            </div>
        }

        @if (canEdit)
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="border-t border-slate-700 pt-3 mt-3 space-y-2">
                @Html.AntiForgeryToken()
                <label class="block text-xs uppercase text-cyan-400">Mettre à jour le statut</label>
                <select name="newStatus" class="w-full">
                    @foreach (var s in Enum.GetValues<CameraStatus>())
                    {
                        <option value="@((int)s)" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
                <textarea name="notes" rows="2" placeholder="Notes (optionnel)"></textarea>
                <button class="btn-primary w-full text-sm">✓ Mettre à jour</button>
            </form>
        }
    </aside>

    <section class="card p-5 lg:col-span-2">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-3">🔧 Historique des interventions (@Model.MaintenanceHistory.Count)</h3>
        @if (Model.MaintenanceHistory.Count == 0)
        {
            <p class="text-slate-400 text-sm">Aucune intervention enregistrée.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var m in Model.MaintenanceHistory.OrderByDescending(x => x.PerformedAt))
                {
                    <div class="border border-slate-700 rounded p-3 text-sm">
                        <div class="flex justify-between items-start gap-2">
                            <span class="font-medium text-slate-200">@m.Action</span>
                            <span class="text-[11px] mono text-slate-500 whitespace-nowrap">@m.PerformedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        <div class="text-xs text-slate-500 mt-1">par @m.PerformedBy · résultat : <span class="@StatusClass(m.ResultingStatus) px-2 py-0.5 rounded text-[10px]">@m.ResultingStatus</span></div>
                        @if (!string.IsNullOrEmpty(m.Notes))
                        {
                            <p class="text-xs text-slate-300 mt-1 italic">"@m.Notes"</p>
                        }
                    </div>
                }
            </div>
        }

        @if (canEdit)
        {
            <details class="mt-4 pt-3 border-t border-slate-700">
                <summary class="text-sm text-cyan-400 cursor-pointer">+ Consigner une intervention</summary>
                <form asp-action="Maintenance" asp-route-id="@Model.Id" method="post" class="mt-3 space-y-3">
                    @Html.AntiForgeryToken()
                    <div><label class="block text-xs mb-1">Action effectuée</label><input name="Action" required /></div>
                    <div><label class="block text-xs mb-1">Statut résultant</label>
                        <select name="ResultingStatus">
                            @foreach (var s in Enum.GetValues<CameraStatus>())
                            { <option value="@((int)s)">@s</option> }
                        </select>
                    </div>
                    <div><label class="block text-xs mb-1">Notes</label><textarea name="Notes" rows="2"></textarea></div>
                    <button class="btn-primary text-sm">✓ Enregistrer l'intervention</button>
                </form>
            </details>
        }
    </section>
</div>
