@{
    ViewData["Title"] = "Annuaire externe";
    var contacts = ViewBag.Contacts as IReadOnlyList<ExternalContact> ?? new List<ExternalContact>();
    var recent = ViewBag.Recent as IReadOnlyList<ContactInteraction> ?? new List<ContactInteraction>();
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">📞 Annuaire contacts externes</h1>
        <p class="text-xs sm:text-sm text-slate-400">Autorités, secours, prestataires — accessible 24/7</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Ajouter un contact</a>
    }
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
        @foreach (var c in contacts)
        {
            <a asp-action="Details" asp-route-id="@c.Id" class="card p-4 hover:border-cyan-400 transition block">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-white">@c.Name</div>
                        <div class="text-xs text-slate-400 mt-1">@c.Type · @c.Role</div>
                    </div>
                    @if (c.IsEmergency24x7)
                    {
                        <span class="badge-rouge text-[10px] px-2 py-0.5 rounded whitespace-nowrap">24/7</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(c.PrimaryPhone))
                {
                    <div class="text-cyan-300 mono mt-3 text-sm">📞 @c.PrimaryPhone</div>
                }
                @if (!string.IsNullOrEmpty(c.EmergencyPhone) && c.EmergencyPhone != c.PrimaryPhone)
                {
                    <div class="text-red-300 mono mt-1 text-sm">🚨 @c.EmergencyPhone</div>
                }
            </a>
        }
    </section>

    <aside class="card p-4 sm:p-5">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-3">📜 Dernières interactions</h3>
        @if (recent.Count == 0)
        {
            <p class="text-slate-400 text-sm">Aucune interaction enregistrée.</p>
        }
        else
        {
            <div class="space-y-2 max-h-[500px] overflow-y-auto">
                @foreach (var i in recent)
                {
                    <div class="border border-slate-700 rounded p-2 text-sm">
                        <div class="flex justify-between items-start gap-2">
                            <span class="text-slate-200">@(i.Direction == InteractionDirection.Sortante ? "→" : "←") @i.Contact?.Name</span>
                            <span class="text-[10px] mono text-slate-500 whitespace-nowrap">@i.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        <div class="text-xs text-slate-400 mt-1">@i.Channel · @i.Subject</div>
                    </div>
                }
            </div>
        }
    </aside>
</div>
