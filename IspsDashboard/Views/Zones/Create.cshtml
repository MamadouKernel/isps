@model RestrictedZone
@{ ViewData["Title"] = "Déclarer une zone restreinte"; }
<div class="mb-5"><h1 class="text-xl sm:text-2xl font-bold text-white">🚧 Déclarer une zone à accès restreint</h1></div>
<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Créer</button>
    </div>
</form>
