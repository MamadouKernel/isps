@model IspsDashboard.Models.ViewModels.AlertCenterViewModel
@{
    string LevelClass(IspsDashboard.Models.ViewModels.AlertLevel l) => l switch
    {
        IspsDashboard.Models.ViewModels.AlertLevel.Critical => "border-l-red-500",
        IspsDashboard.Models.ViewModels.AlertLevel.Warning => "border-l-amber-500",
        _ => "border-l-cyan-500"
    };
}
<div class="dd" data-dd>
    <button type="button" class="dd-toggle relative" title="Notifications" aria-label="Notifications">
        <span class="text-lg">🔔</span>
        @if (Model.TotalCount > 0)
        {
            <span class="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full text-[10px] font-bold flex items-center justify-center @(Model.CriticalCount > 0 ? "bg-red-500 text-white" : "bg-amber-500 text-black")">@Model.TotalCount</span>
        }
    </button>
    <div class="dd-panel !min-w-[340px] max-h-[70vh] overflow-y-auto">
        <div class="dd-section flex items-center justify-between">
            <span>Notifications</span>
            <span class="text-slate-400">@Model.TotalCount alerte(s)</span>
        </div>
        @if (Model.TotalCount == 0)
        {
            <div class="px-3 py-6 text-center text-slate-400 text-sm">✓ Aucune alerte active</div>
        }
        else
        {
            foreach (var a in Model.Alerts)
            {
                <a href="@a.Url" class="block px-3 py-2 border-l-2 @LevelClass(a.Level) hover:bg-cyan-500/10 rounded-r mb-1">
                    <div class="text-sm text-slate-200 flex items-start gap-2">
                        <span>@a.Icon</span>
                        <span class="font-medium">@a.Title</span>
                    </div>
                    <div class="text-xs text-slate-400 ml-6">@a.Detail</div>
                </a>
            }
        }
    </div>
</div>
