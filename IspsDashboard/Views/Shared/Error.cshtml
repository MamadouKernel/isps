@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="max-w-xl mx-auto mt-10 sm:mt-16">
    <div class="card p-6 sm:p-8 text-center">
        <div class="text-4xl mb-3">⚠️</div>
        <h1 class="text-xl sm:text-2xl font-bold text-white mb-2">Une erreur est survenue</h1>
        <p class="text-sm text-slate-400 mb-6">
            Le traitement de votre demande a échoué. L'incident a été journalisé — réessayez, et contactez l'administrateur si le problème persiste.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-xs text-slate-500 mb-6">
                Identifiant de suivi : <span class="mono text-cyan-400">@Model.RequestId</span>
            </p>
        }

        <a asp-controller="Dashboard" asp-action="Index" class="btn-primary inline-block">← Retour au tableau de bord</a>
    </div>
</div>
