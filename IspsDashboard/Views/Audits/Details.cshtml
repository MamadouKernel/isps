@model SecurityAudit
@{
    ViewData["Title"] = Model.Reference;
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    var score = Model.ConformityScore();
    string FindingClass(FindingResult r) => r switch
    {
        FindingResult.Conforme => "badge-vert",
        FindingResult.NonConforme => "badge-rouge",
        FindingResult.Observation => "badge-ambre",
        _ => "badge-bleu"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div>
        <div class="flex items-center gap-3 flex-wrap">
            <span class="mono text-2xl text-cyan-400 font-bold">@Model.Reference</span>
            <span class="badge-bleu text-xs px-2 py-1 rounded">@Model.Type</span>
            <span class="@(Model.Status == AuditStatus.Cloture ? "badge-vert" : "badge-ambre") text-xs px-2 py-1 rounded">@Model.Status</span>
        </div>
        <h1 class="text-lg sm:text-xl text-white font-semibold mt-2">@Model.Title</h1>
        <div class="text-xs text-slate-400 mt-1">@Model.ScheduledDate.ToString("dd/MM/yyyy") · @Model.Auditor · @Model.Scope</div>
    </div>
    <div class="text-center">
        <div class="text-3xl font-bold mono @(score >= 90 ? "text-emerald-400" : score >= 70 ? "text-amber-400" : "text-red-400")">@score%</div>
        <div class="text-xs text-slate-500">conformité</div>
        <a asp-action="Index" class="btn-secondary text-sm mt-2 inline-block">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm mt-2 inline-block">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "Audits",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Déplacer cet audit vers la corbeille ?",
                FormClass = "mt-2"
            })
        }
    </div>
</div>

<div class="card p-4 sm:p-5 mb-5">
    <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-3">Points de contrôle (@Model.Findings.Count)</h3>
    <div class="space-y-2">
        @foreach (var f in Model.Findings.OrderBy(x => x.ItemNumber))
        {
            <div class="border border-slate-700 rounded p-3">
                <div class="flex items-start justify-between gap-3 flex-wrap">
                    <div class="flex-1 min-w-0">
                        <span class="mono text-cyan-400 text-xs">#@f.ItemNumber</span>
                        <span class="text-sm text-slate-200 ml-2">@f.CheckItem</span>
                    </div>
                    <span class="@FindingClass(f.Result) text-xs px-2 py-0.5 rounded whitespace-nowrap">@f.Result</span>
                </div>
                @if (canEdit && Model.Status != AuditStatus.Cloture)
                {
                    <form asp-action="UpdateFinding" method="post" class="mt-2 flex flex-col sm:flex-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="auditId" value="@Model.Id" />
                        <input type="hidden" name="findingId" value="@f.Id" />
                        <select name="result" class="sm:w-48">
                            @foreach (var r in Enum.GetValues<FindingResult>())
                            {
                                <option value="@((int)r)" selected="@(f.Result == r)">@r</option>
                            }
                        </select>
                        <input name="observation" value="@f.Observation" placeholder="Constat / observation" class="flex-1" />
                        <button class="btn-secondary text-xs whitespace-nowrap">✓ Enregistrer</button>
                    </form>
                }
                else if (!string.IsNullOrEmpty(f.Observation))
                {
                    <p class="text-xs text-slate-400 mt-1 italic">@f.Observation</p>
                }
                @if (canEdit && f.Result == FindingResult.NonConforme)
                {
                    <form asp-action="GenerateNonConformity" method="post" class="mt-2"
                          data-confirm="Créer une non-conformité depuis ce constat ?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="auditId" value="@Model.Id" />
                        <input type="hidden" name="findingId" value="@f.Id" />
                        <button class="btn-secondary text-xs">❗ Générer une non-conformité</button>
                    </form>
                }
            </div>
        }
    </div>
</div>

@if (Model.Status != AuditStatus.Cloture && canEdit)
{
    <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="card p-4 sm:p-5">
        @Html.AntiForgeryToken()
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Clôturer l'audit</h3>
        <textarea name="conclusion" rows="3" placeholder="Synthèse, conclusion générale, recommandations principales…"></textarea>
        <button class="btn-primary mt-2">✓ Clôturer l'audit</button>
    </form>
}
else if (!string.IsNullOrEmpty(Model.Conclusion))
{
    <div class="card p-4 sm:p-5">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Conclusion</h3>
        <p class="whitespace-pre-wrap text-slate-200 text-sm">@Model.Conclusion</p>
    </div>
}
