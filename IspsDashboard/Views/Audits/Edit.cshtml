@model SecurityAudit
@{ ViewData["Title"] = "Modifier l'audit"; }
<div class="mb-5"><h1 class="text-xl sm:text-2xl font-bold text-white">✏️ Audit @Model.Reference</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2"><label asp-for="Title" class="block text-sm mb-1"></label><input asp-for="Title" required /></div>
        <div><label asp-for="Type" class="block text-sm mb-1"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<AuditType>()"></select></div>
        <div><label asp-for="ScheduledDate" class="block text-sm mb-1"></label><input asp-for="ScheduledDate" type="date" /></div>
        <div><label asp-for="Auditor" class="block text-sm mb-1"></label><input asp-for="Auditor" /></div>
        <div><label asp-for="Scope" class="block text-sm mb-1"></label><input asp-for="Scope" /></div>
    </div>
    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Enregistrer</button>
    </div>
</form>
