@model IReadOnlyList<SecurityAudit>
@{
    ViewData["Title"] = "Audits internes";
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string StatusClass(AuditStatus s) => s switch
    {
        AuditStatus.Planifie => "badge-ambre",
        AuditStatus.EnCours => "badge-bleu",
        _ => "badge-vert"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">🔍 Audits de sûreté</h1>
        <p class="text-xs sm:text-sm text-slate-400">Audits internes/externes basés sur les points de contrôle ISPS Part B</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Planifier un audit</a>
    }
</div>

<div class="card p-3 sm:p-4">
    @if (Model.Count == 0)
    {
        <p class="text-center text-slate-400 py-8">Aucun audit enregistré.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="w-full text-sm">
                <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2 whitespace-nowrap">Réf.</th>
                        <th class="text-left p-2">Intitulé</th>
                        <th class="text-left p-2">Type</th>
                        <th class="text-left p-2 whitespace-nowrap">Date prévue</th>
                        <th class="text-center p-2">Conformité</th>
                        <th class="text-center p-2">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var score = a.ConformityScore();
                        <tr class="border-b border-slate-800 hover:bg-slate-800/40 cursor-pointer" onclick="location='@Url.Action("Details", new { id = a.Id })'">
                            <td class="p-2 mono text-cyan-400">@a.Reference</td>
                            <td class="p-2 text-slate-200">@a.Title</td>
                            <td class="p-2 text-slate-400">@a.Type</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@a.ScheduledDate.ToString("dd/MM/yyyy")</td>
                            <td class="p-2 text-center">
                                <span class="@(score >= 90 ? "text-emerald-400" : score >= 70 ? "text-amber-400" : "text-red-400") font-bold mono">@score%</span>
                            </td>
                            <td class="p-2 text-center"><span class="@StatusClass(a.Status) text-xs px-2 py-0.5 rounded">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
