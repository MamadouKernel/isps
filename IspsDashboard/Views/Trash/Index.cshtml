@model TrashViewModel
@{
    ViewData["Title"] = "Corbeille";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">🗑️ Corbeille</h1>
    <p class="text-xs sm:text-sm text-slate-400">Éléments supprimés (suppression logique) — restaurables. Rien n'est jamais effacé définitivement.</p>
</div>

<div class="card p-3 sm:p-4">
    @if (Model.Entries.Count == 0)
    {
        <p class="text-center text-slate-400 py-8">✓ La corbeille est vide.</p>
    }
    else
    {
        <p class="text-xs text-slate-500 sm:hidden mb-2">↔️ Faites défiler horizontalement</p>
        <div class="table-wrap">
            <table class="w-full text-xs sm:text-sm">
                <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2">Type</th>
                        <th class="text-left p-2">Élément</th>
                        <th class="text-left p-2 whitespace-nowrap">Supprimé le</th>
                        <th class="text-right p-2">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        <tr class="border-b border-slate-800">
                            <td class="p-2"><span class="badge-bleu text-[10px] px-2 py-0.5 rounded">@e.TypeLabel</span></td>
                            <td class="p-2 text-slate-200">@e.Label</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@(e.DeletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="p-2 text-right">
                                <form asp-action="Restore" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="type" value="@e.TypeName" />
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <button class="btn-secondary text-xs">♻️ Restaurer</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
