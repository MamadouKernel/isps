@model IncidentEditViewModel
@{
    ViewData["Title"] = "Modifier l'incident";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">✏️ Modifier l'incident</h1>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />
    <partial name="_Form" model="Model" />

    <div class="flex flex-col sm:flex-row sm:justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary text-center">Annuler</a>
        <button type="submit" class="btn-primary">✓ Enregistrer</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
