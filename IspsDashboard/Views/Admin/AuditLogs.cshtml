@model List<AuditLog>
@{
    ViewData["Title"] = "Journal d'audit";
}
<div class="mb-4 sm:mb-6">
    <h1 class="text-xl sm:text-2xl font-bold text-white">📋 Journal d'audit</h1>
    <p class="text-xs sm:text-sm text-slate-400">200 dernières actions</p>
</div>

<div class="card p-3 sm:p-4">
    <p class="text-xs text-slate-500 sm:hidden mb-2">↔️ Faites défiler horizontalement</p>
    <div class="table-wrap">
        <table class="w-full text-xs sm:text-sm">
            <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                <tr>
                    <th class="text-left p-2 whitespace-nowrap">Date</th>
                    <th class="text-left p-2 whitespace-nowrap">Utilisateur</th>
                    <th class="text-left p-2 whitespace-nowrap">Action</th>
                    <th class="text-left p-2">Détail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr class="border-b border-slate-800">
                        <td class="p-2 mono text-slate-400 whitespace-nowrap">@l.Timestamp.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                        <td class="p-2 text-cyan-300 truncate max-w-[160px]">@l.UserName</td>
                        <td class="p-2 text-slate-200 whitespace-nowrap">@l.Action</td>
                        <td class="p-2 text-slate-400 break-words">@l.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
