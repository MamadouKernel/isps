@model Agent
@{
    ViewData["Title"] = Model.Name;
    var habService = ViewBag.HabilitationService as IHabilitationService;
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div class="flex items-center gap-4">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Model.PhotoPath" alt="Photo de @Model.Name" class="w-20 h-20 rounded-full object-cover border border-slate-700" />
        }
        else
        {
            <div class="w-20 h-20 rounded-full bg-slate-700 flex items-center justify-center text-3xl text-slate-400">@Model.Name.FirstOrDefault()</div>
        }
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-white">@Model.Name</h1>
            <div class="flex items-center gap-2 mt-1 flex-wrap">
                <span class="mono text-cyan-400 text-xs">Position #@Model.Position</span>
                <span class="text-xs text-slate-400">· @Model.Role</span>
                <span class="@(Model.IsPresent ? "badge-vert" : "badge-rouge") text-xs px-2 py-0.5 rounded">@(Model.IsPresent ? "Présent" : "Absent")</span>
            </div>
        </div>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-secondary text-sm">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "Personnel",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Retirer cet agent (corbeille) ?",
                ButtonLabel = "🗑️ Retirer"
            })
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    <aside class="card p-5 space-y-2">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Contact</h3>
        <dl class="text-sm space-y-2">
            <div><dt class="text-slate-500 text-xs">Badge</dt><dd class="mono text-slate-200">@(string.IsNullOrEmpty(Model.BadgeNumber) ? "—" : Model.BadgeNumber)</dd></div>
            <div><dt class="text-slate-500 text-xs">Téléphone</dt><dd class="text-slate-200">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd></div>
            <div><dt class="text-slate-500 text-xs">Email</dt><dd class="text-cyan-300">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd></div>
            <div><dt class="text-slate-500 text-xs">Date d'embauche</dt><dd class="text-slate-200 mono">@(Model.HiredAt?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
        </dl>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="border-t border-slate-700 pt-3 mt-3">
                <div class="text-xs text-slate-500 mb-1">Notes internes</div>
                <p class="text-sm text-slate-300 whitespace-pre-wrap">@Model.Notes</p>
            </div>
        }
    </aside>

    <div class="card p-5 lg:col-span-2">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm uppercase tracking-wider text-cyan-400">🎓 Habilitations & formations (@Model.Habilitations.Count)</h3>
        </div>

        @if (Model.Habilitations.Count == 0)
        {
            <p class="text-slate-400 text-sm">Aucune habilitation enregistrée pour cet agent.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var h in Model.Habilitations.OrderBy(x => x.ExpiresAt))
                {
                    var status = habService?.ClassifyExpiry(h) ?? HabilitationStatus.Valide;
                    var days = habService?.DaysToExpiry(h) ?? 0;
                    string cls = status switch
                    {
                        HabilitationStatus.Valide => "badge-vert",
                        HabilitationStatus.Bientot => "badge-ambre",
                        HabilitationStatus.Urgent => "badge-rouge",
                        _ => "badge-rouge"
                    };
                    string label = status switch
                    {
                        HabilitationStatus.Valide => $"J-{days}",
                        HabilitationStatus.Bientot => $"J-{days}",
                        HabilitationStatus.Urgent => $"⚠ J-{days}",
                        _ => $"Expirée depuis {Math.Abs(days)} j"
                    };
                    <div class="flex items-center justify-between border border-slate-700 rounded p-3 gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-sm text-slate-200 font-medium">@h.Title</div>
                            <div class="text-xs text-slate-500 mt-0.5">@h.Category · @(string.IsNullOrEmpty(h.Issuer) ? "Organisme N/C" : h.Issuer) · réf. @(string.IsNullOrEmpty(h.Reference) ? "—" : h.Reference)</div>
                            <div class="text-xs text-slate-400 mt-1 mono">Obtenue: @h.ObtainedAt.ToString("dd/MM/yyyy") · Expire: @h.ExpiresAt.ToString("dd/MM/yyyy")</div>
                        </div>
                        <span class="@cls text-xs px-2 py-1 rounded mono whitespace-nowrap">@label</span>
                        @if (canEdit)
                        {
                            <a asp-controller="Habilitations" asp-action="Edit" asp-route-id="@h.Id" class="btn-secondary text-xs" title="Modifier">✏️</a>
                            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                            {
                                Controller = "Habilitations",
                                RouteValues = { ["id"] = h.Id.ToString(), ["agentId"] = Model.Id.ToString() },
                                ConfirmMessage = "Supprimer ?",
                                ButtonLabel = "✕",
                                ButtonClass = "btn-danger text-xs",
                                FormClass = ""
                            })
                        }
                    </div>
                }
            </div>
        }

        @if (canEdit)
        {
            <details class="mt-4 pt-3 border-t border-slate-700">
                <summary class="cursor-pointer text-sm text-cyan-400">+ Ajouter une habilitation</summary>
                <form asp-controller="Habilitations" asp-action="Create" method="post" class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="agentId" value="@Model.Id" />
                    <div><label class="block text-xs mb-1">Catégorie</label>
                        <select name="Category">
                            @foreach (var c in Enum.GetValues<HabilitationCategory>())
                            { <option value="@((int)c)">@c</option> }
                        </select>
                    </div>
                    <div><label class="block text-xs mb-1">Intitulé</label><input name="Title" required /></div>
                    <div><label class="block text-xs mb-1">Organisme</label><input name="Issuer" /></div>
                    <div><label class="block text-xs mb-1">N° référence</label><input name="Reference" /></div>
                    <div><label class="block text-xs mb-1">Date d'obtention</label><input name="ObtainedAt" type="date" required /></div>
                    <div><label class="block text-xs mb-1">Date d'expiration</label><input name="ExpiresAt" type="date" required /></div>
                    <div class="md:col-span-2 flex justify-end"><button type="submit" class="btn-primary text-sm">✓ Ajouter</button></div>
                </form>
            </details>
        }
    </div>
</div>
