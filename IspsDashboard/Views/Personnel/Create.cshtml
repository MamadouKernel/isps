@model Agent
@{
    ViewData["Title"] = "Ajouter un agent";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">+ Ajouter un agent</h1>
</div>

<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label asp-for="Name" class="block text-sm mb-1"></label><input asp-for="Name" required /></div>
        <div><label asp-for="Position" class="block text-sm mb-1"></label><input asp-for="Position" type="number" min="1" required /></div>
        <div><label asp-for="Role" class="block text-sm mb-1"></label><input asp-for="Role" /></div>
        <div><label asp-for="BadgeNumber" class="block text-sm mb-1"></label><input asp-for="BadgeNumber" /></div>
        <div><label asp-for="HiredAt" class="block text-sm mb-1"></label><input asp-for="HiredAt" type="date" /></div>
        <div><label asp-for="Phone" class="block text-sm mb-1"></label><input asp-for="Phone" /></div>
        <div><label asp-for="Email" class="block text-sm mb-1"></label><input asp-for="Email" /></div>
        <div class="flex items-end">
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="IsPresent" value="true" checked />
                <input type="hidden" name="IsPresent" value="false" />
                <span>Présent aujourd'hui</span>
            </label>
        </div>
        <div class="md:col-span-2">
            <label asp-for="Notes" class="block text-sm mb-1"></label>
            <textarea asp-for="Notes" rows="3"></textarea>
        </div>
    </div>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary">Annuler</a>
        <button class="btn-primary">✓ Créer</button>
    </div>
</form>
