@model AnalyticsViewModel
@{
    ViewData["Title"] = "Statistiques";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">📈 Statistiques & tendances (12 mois)</h1>
    <p class="text-xs sm:text-sm text-slate-400">Évolution des indicateurs de sûreté sur l'année glissante</p>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
    <div class="card p-4"><div class="text-[11px] uppercase text-slate-400">Incidents (12 mois)</div><div class="text-2xl font-bold mono text-white">@Model.TotalIncidents12m</div></div>
    <div class="card p-4"><div class="text-[11px] uppercase text-slate-400">Mouvements véhicules</div><div class="text-2xl font-bold mono text-cyan-400">@Model.TotalVehicles12m</div></div>
    <div class="card p-4"><div class="text-[11px] uppercase text-slate-400">NC ouvertes</div><div class="text-2xl font-bold mono text-amber-400">@Model.OpenNonConformities</div></div>
    <div class="card p-4"><div class="text-[11px] uppercase text-slate-400">Dispo. CCTV</div><div class="text-2xl font-bold mono text-emerald-400">@Model.CctvAvailability%</div></div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card p-4 sm:p-5"><h3 class="font-semibold text-white text-sm mb-3">🚨 Incidents par mois</h3><canvas id="incidentsChart" height="200"></canvas></div>
    <div class="card p-4 sm:p-5"><h3 class="font-semibold text-white text-sm mb-3">🚚 Mouvements véhicules par mois</h3><canvas id="vehiclesChart" height="200"></canvas></div>
    <div class="card p-4 sm:p-5"><h3 class="font-semibold text-white text-sm mb-3">🏋️ Exercices réalisés par mois</h3><canvas id="exercisesChart" height="200"></canvas></div>
    <div class="card p-4 sm:p-5"><h3 class="font-semibold text-white text-sm mb-3">❗ Non-conformités identifiées par mois</h3><canvas id="ncChart" height="200"></canvas></div>
</div>

@section Scripts {
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels));
        const gridColor = 'rgba(148,163,184,0.12)';
        const tickColor = '#94a3b8';
        const baseOpts = (yTitle) => ({
            responsive: true, maintainAspectRatio: true,
            scales: {
                y: { beginAtZero: true, ticks: { color: tickColor, precision: 0 }, grid: { color: gridColor } },
                x: { ticks: { color: tickColor, font: { size: 10 } }, grid: { color: gridColor } }
            },
            plugins: { legend: { display: false } }
        });
        function bar(id, data, color) {
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: { labels, datasets: [{ data, backgroundColor: color, borderRadius: 4 }] },
                options: baseOpts()
            });
        }
        function line(id, data, color) {
            new Chart(document.getElementById(id), {
                type: 'line',
                data: { labels, datasets: [{ data, borderColor: color, backgroundColor: color + '33', fill: true, tension: 0.3, pointRadius: 3 }] },
                options: baseOpts()
            });
        }
        line('incidentsChart', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IncidentsPerMonth)), '#ef4444');
        bar('vehiclesChart', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehiclesPerMonth)), '#22d3ee');
        bar('exercisesChart', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExercisesRealisedPerMonth)), '#10b981');
        line('ncChart', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NonConformitiesPerMonth)), '#f59e0b');
    </script>
}
