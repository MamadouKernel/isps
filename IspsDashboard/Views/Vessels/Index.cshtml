@{
    ViewData["Title"] = "Navires & DoS";
    var upcoming = ViewBag.Upcoming as IReadOnlyList<VesselCall> ?? new List<VesselCall>();
    var filtered = ViewBag.Filtered as IReadOnlyList<VesselCall> ?? new List<VesselCall>();
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string StatusClass(VesselCallStatus s) => s switch
    {
        VesselCallStatus.Annonce => "badge-ambre",
        VesselCallStatus.EnApproche => "badge-ambre",
        VesselCallStatus.AQuai => "badge-vert",
        VesselCallStatus.EnOperation => "badge-vert",
        VesselCallStatus.Parti => "badge-bleu",
        _ => "badge-rouge"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">🚢 Navires & Déclarations de Sûreté</h1>
        <p class="text-xs sm:text-sm text-slate-400">Escales prévues, en cours et journal des DoS (ISPS Part A § 5)</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Annoncer une escale</a>
    }
</div>

<section class="card p-4 sm:p-5 mb-5">
    <h3 class="font-semibold text-cyan-400 text-sm uppercase mb-3">⏳ Escales à venir (14 jours)</h3>
    @if (upcoming.Count == 0)
    {
        <p class="text-slate-400 text-sm">Aucune escale prévue.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="w-full text-sm">
                <thead class="text-xs text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2 whitespace-nowrap">Réf.</th>
                        <th class="text-left p-2">Navire</th>
                        <th class="text-left p-2">Pavillon</th>
                        <th class="text-left p-2 whitespace-nowrap">ETA</th>
                        <th class="text-left p-2">Quai</th>
                        <th class="text-center p-2">N° ISPS navire</th>
                        <th class="text-center p-2">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in upcoming)
                    {
                        <tr class="border-b border-slate-800 hover:bg-slate-800/40 cursor-pointer"
                            data-href="@Url.Action("Details", new { id = v.Id })">
                            <td class="p-2 mono text-cyan-400">@v.Reference</td>
                            <td class="p-2 text-slate-200">@v.VesselName <span class="text-xs text-slate-500">(@v.ImoNumber)</span></td>
                            <td class="p-2 text-slate-400">@v.Flag</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@v.Eta.ToString("dd/MM HH:mm")</td>
                            <td class="p-2 mono text-slate-400">@v.Berth</td>
                            <td class="p-2 text-center"><span class="badge-bleu text-xs px-2 py-0.5 rounded">N°@v.ShipIspsLevel</span></td>
                            <td class="p-2 text-center"><span class="@StatusClass(v.Status) text-xs px-2 py-0.5 rounded">@v.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card p-4 sm:p-5">
    <h3 class="font-semibold text-cyan-400 text-sm uppercase mb-3">📜 Historique des escales</h3>
    @if (filtered.Count == 0)
    {
        <p class="text-slate-400 text-sm">Aucune escale enregistrée.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="w-full text-sm">
                <thead class="text-xs text-slate-400 border-b border-slate-700">
                    <tr><th class="text-left p-2">Réf.</th><th class="text-left p-2">Navire</th><th class="text-left p-2">Période</th><th class="text-center p-2">DoS</th><th class="text-center p-2">Statut</th></tr>
                </thead>
                <tbody>
                    @foreach (var v in filtered)
                    {
                        <tr class="border-b border-slate-800 hover:bg-slate-800/40 cursor-pointer" data-href="@Url.Action("Details", new { id = v.Id })">
                            <td class="p-2 mono text-cyan-400">@v.Reference</td>
                            <td class="p-2 text-slate-200">@v.VesselName</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@v.Eta.ToString("dd/MM") → @(v.Etd?.ToString("dd/MM") ?? "—")</td>
                            <td class="p-2 text-center"><span class="badge-bleu text-xs px-2 py-0.5 rounded">@v.Declarations.Count</span></td>
                            <td class="p-2 text-center"><span class="@StatusClass(v.Status) text-xs px-2 py-0.5 rounded">@v.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
