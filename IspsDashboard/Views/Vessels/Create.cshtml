@model VesselCall
@{
    ViewData["Title"] = "Annoncer une escale";
}
<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">🚢 Annoncer une escale</h1>
    <p class="text-xs sm:text-sm text-slate-400">Référence générée automatiquement (ESC-année-numéro).</p>
</div>

<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label asp-for="VesselName" class="block text-sm mb-1"></label><input asp-for="VesselName" required /></div>
        <div><label asp-for="ImoNumber" class="block text-sm mb-1"></label><input asp-for="ImoNumber" placeholder="9876543" /></div>
        <div><label asp-for="CallSign" class="block text-sm mb-1"></label><input asp-for="CallSign" /></div>
        <div><label asp-for="Flag" class="block text-sm mb-1"></label><input asp-for="Flag" /></div>
        <div><label asp-for="Operator" class="block text-sm mb-1"></label><input asp-for="Operator" /></div>
        <div><label asp-for="CrewCount" class="block text-sm mb-1"></label><input asp-for="CrewCount" type="number" min="0" /></div>
        <div><label asp-for="Cso" class="block text-sm mb-1"></label><input asp-for="Cso" /></div>
        <div><label asp-for="Sso" class="block text-sm mb-1"></label><input asp-for="Sso" /></div>
        <div><label asp-for="Eta" class="block text-sm mb-1"></label><input asp-for="Eta" type="datetime-local" required /></div>
        <div><label asp-for="Etd" class="block text-sm mb-1"></label><input asp-for="Etd" type="datetime-local" /></div>
        <div><label asp-for="Berth" class="block text-sm mb-1"></label><input asp-for="Berth" placeholder="Q4 nord" /></div>
        <div><label asp-for="ShipIspsLevel" class="block text-sm mb-1"></label>
            <select asp-for="ShipIspsLevel">
                <option value="1">Niveau 1</option><option value="2">Niveau 2</option><option value="3">Niveau 3</option>
            </select>
            <p class="text-xs text-slate-500 mt-1">Niveau port actuel : <span class="text-amber-400 mono">N°@ViewBag.PortLevel</span> — une DoS sera requise si les niveaux diffèrent.</p>
        </div>
        <div class="md:col-span-2"><label asp-for="LastTenPorts" class="block text-sm mb-1"></label><textarea asp-for="LastTenPorts" rows="2" placeholder="Liste des 10 derniers ports d'escale (obligation ISPS Part A § 4)"></textarea></div>
        <div class="md:col-span-2"><label asp-for="SecurityNotes" class="block text-sm mb-1"></label><textarea asp-for="SecurityNotes" rows="3"></textarea></div>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary text-center">Annuler</a>
        <button type="submit" class="btn-primary">✓ Enregistrer</button>
    </div>
</form>
