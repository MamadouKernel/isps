@model IspsDashboard.Models.ViewModels.ExerciseAlertEmailModel
@{
    Layout = null;
    var urgency = Model.DaysRemaining <= 7 ? "URGENT" : "À venir";
    var urgencyColor = Model.DaysRemaining <= 7 ? "#ef4444" : "#f59e0b";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Alerte sûreté ISPS</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; background:#f3f4f6; padding:24px; margin:0; color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;">
        <tr>
            <td style="background:#0a1628;padding:20px 24px;color:#ffffff;">
                <div style="font-size:18px;font-weight:bold;letter-spacing:1px;">@Model.TerminalTitle</div>
                <div style="height:2px;width:120px;background:#d4a017;margin-top:6px;"></div>
                <div style="font-size:12px;color:#94a3b8;margin-top:8px;">Tableau de bord Sûreté — Code ISPS</div>
            </td>
        </tr>
        <tr>
            <td style="padding:24px;">
                <div style="display:inline-block;padding:4px 12px;border-radius:4px;background:@urgencyColor;color:#ffffff;font-size:12px;font-weight:bold;letter-spacing:1px;">@urgency</div>
                <h2 style="margin:16px 0 8px 0;color:#0a1628;font-size:20px;">Exercice à venir</h2>
                <p style="margin:0 0 16px 0;font-size:15px;color:#374151;">
                    L'exercice <strong>@Model.Exercise.Name</strong> est prévu le
                    <strong>@Model.Exercise.PlannedDate.ToString("dd/MM/yyyy")</strong>
                    (@(Model.DaysRemaining == 0 ? "aujourd'hui" : $"dans {Model.DaysRemaining} jour(s)")).
                </p>
                <table role="presentation" width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                    <tr><td style="color:#6b7280;width:35%;">Type</td><td style="color:#111827;">@Model.Exercise.Type</td></tr>
                    <tr><td style="color:#6b7280;">Responsable</td><td style="color:#111827;">@Model.Exercise.Responsible</td></tr>
                    <tr><td style="color:#6b7280;">Date prévue</td><td style="color:#111827;">@Model.Exercise.PlannedDate.ToString("dddd dd MMMM yyyy")</td></tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:16px 24px;background:#f9fafb;color:#94a3b8;font-size:11px;border-top:1px solid #e5e7eb;">
                Notification automatique — Tableau de bord Sûreté ISPS · CDC-ISPS-2026-001
            </td>
        </tr>
    </table>
</body>
</html>
