@{
    ViewData["Title"] = "Contrôle d'accès véhicules";
    var today = ViewBag.Today as IReadOnlyList<VehicleAccess> ?? new List<VehicleAccess>();
    var results = ViewBag.Results as IReadOnlyList<VehicleAccess> ?? new List<VehicleAccess>();
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string ResultClass(AccessControlResult r) => r switch
    {
        AccessControlResult.Autorise => "badge-vert",
        AccessControlResult.Refuse => "badge-rouge",
        _ => "badge-ambre"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">🚚 Contrôle d'accès véhicules & camions</h1>
        <p class="text-xs sm:text-sm text-slate-400">Journal des entrées/sorties — plaques, conteneurs, scellés (ISPS Part A § 7)</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Enregistrer un contrôle</a>
    }
</div>

<div class="grid grid-cols-3 gap-3 mb-5">
    <div class="card p-3 text-center"><div class="text-[11px] uppercase text-slate-400">Mouvements aujourd'hui</div><div class="text-2xl font-bold mono text-cyan-400">@today.Count</div></div>
    <div class="card p-3 text-center"><div class="text-[11px] uppercase text-slate-400">Entrées</div><div class="text-2xl font-bold mono text-emerald-400">@today.Count(t => t.Direction == AccessDirection.Entree)</div></div>
    <div class="card p-3 text-center"><div class="text-[11px] uppercase text-slate-400">Refusés</div><div class="text-2xl font-bold mono text-red-400">@today.Count(t => t.Result == AccessControlResult.Refuse)</div></div>
</div>

<form method="get" class="card p-4 mb-5 grid grid-cols-1 sm:grid-cols-4 gap-3">
    <input name="query" value="@ViewBag.Query" placeholder="🔍 Plaque, conteneur, conducteur…" class="sm:col-span-2" />
    <select name="direction">
        <option value="">— Tous sens —</option>
        @foreach (var d in Enum.GetValues<AccessDirection>())
        {
            <option value="@d" selected="@(ViewBag.Direction?.ToString() == d.ToString())">@d</option>
        }
    </select>
    <button class="btn-primary">Filtrer</button>
</form>

<div class="flex justify-end gap-2 mb-3">
    <a asp-action="ExportExcel" asp-route-direction="@ViewBag.Direction" asp-route-query="@ViewBag.Query" class="btn-secondary text-xs">📊 Excel</a>
    <a asp-action="ExportPdf" asp-route-direction="@ViewBag.Direction" asp-route-query="@ViewBag.Query" target="_blank" class="btn-secondary text-xs">📄 PDF</a>
</div>

<div class="card p-3 sm:p-4">
    @if (results.Count == 0)
    {
        <p class="text-center text-slate-400 py-8">Aucun mouvement enregistré.</p>
    }
    else
    {
        <p class="text-xs text-slate-500 sm:hidden mb-2">↔️ Faites défiler horizontalement</p>
        <div class="table-wrap">
            <table class="w-full text-xs sm:text-sm">
                <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2 whitespace-nowrap">Réf.</th>
                        <th class="text-left p-2 whitespace-nowrap">Date/heure</th>
                        <th class="text-left p-2">Plaque</th>
                        <th class="text-left p-2">Sens</th>
                        <th class="text-left p-2">Conducteur</th>
                        <th class="text-left p-2">Conteneur</th>
                        <th class="text-center p-2">Scellé</th>
                        <th class="text-center p-2">Résultat</th>
                        <th class="text-right p-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in results)
                    {
                        <tr class="border-b border-slate-800">
                            <td class="p-2 mono text-cyan-400">@v.Reference</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@v.OccurredAt.ToString("dd/MM HH:mm")</td>
                            <td class="p-2 mono text-slate-200">@v.Plate</td>
                            <td class="p-2 text-slate-400">@v.Direction</td>
                            <td class="p-2 text-slate-400">@v.DriverName</td>
                            <td class="p-2 mono text-slate-400">@v.ContainerNumber</td>
                            <td class="p-2 text-center">@(string.IsNullOrEmpty(v.SealNumber) ? "—" : (v.SealVerified ? "✓" : "⚠"))</td>
                            <td class="p-2 text-center"><span class="@ResultClass(v.Result) text-xs px-2 py-0.5 rounded">@v.Result</span></td>
                            <td class="p-2 text-right whitespace-nowrap">
                                <a asp-action="Details" asp-route-id="@v.Id" class="btn-secondary text-xs" title="Détails">👁️</a>
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn-secondary text-xs" title="Modifier">✏️</a>
                                    @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                                    {
                                        Controller = "VehicleAccess",
                                        RouteValues = { ["id"] = v.Id.ToString() },
                                        ConfirmMessage = "Déplacer vers la corbeille ?",
                                        ButtonLabel = "🗑️",
                                        ButtonClass = "btn-danger text-xs"
                                    })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
