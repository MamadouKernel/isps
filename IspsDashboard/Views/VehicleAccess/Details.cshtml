@model VehicleAccess
@{
    ViewData["Title"] = Model.Reference;
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    string ResultClass(AccessControlResult r) => r switch
    {
        AccessControlResult.Autorise => "badge-vert",
        AccessControlResult.Refuse => "badge-rouge",
        _ => "badge-ambre"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 mb-5">
    <div>
        <div class="text-xs text-slate-400 uppercase tracking-wider">Contrôle d'accès véhicule</div>
        <div class="flex items-center gap-3 mt-1 flex-wrap">
            <span class="mono text-2xl text-cyan-400 font-bold">@Model.Reference</span>
            <span class="@ResultClass(Model.Result) text-xs px-2 py-1 rounded">@Model.Result</span>
            <span class="badge-bleu text-xs px-2 py-1 rounded">@Model.Direction</span>
        </div>
        <h1 class="text-lg sm:text-xl text-white font-semibold mt-2">@Model.Plate <span class="text-sm text-slate-500">@Model.Type</span></h1>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-secondary text-sm">← Retour</a>
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary text-sm">✏️ Modifier</a>
            @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
            {
                Controller = "VehicleAccess",
                RouteValues = { ["id"] = Model.Id.ToString() },
                ConfirmMessage = "Déplacer ce mouvement vers la corbeille ?"
            })
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card p-5 space-y-2">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Conducteur & transport</h3>
        <dl class="text-sm space-y-2">
            <div><dt class="text-slate-500 text-xs">Conducteur</dt><dd class="text-slate-200">@Model.DriverName</dd></div>
            <div><dt class="text-slate-500 text-xs">Pièce d'identité</dt><dd class="text-slate-200 mono">@Model.DriverIdNumber</dd></div>
            <div><dt class="text-slate-500 text-xs">Transporteur</dt><dd class="text-slate-200">@Model.Carrier</dd></div>
            <div><dt class="text-slate-500 text-xs">Portail</dt><dd class="text-slate-200">@Model.Gate</dd></div>
            <div><dt class="text-slate-500 text-xs">Agent contrôleur</dt><dd class="text-slate-200">@Model.Controller</dd></div>
        </dl>
    </div>
    <div class="card p-5 space-y-2">
        <h3 class="text-sm uppercase tracking-wider text-cyan-400 mb-2">Marchandise & contrôle</h3>
        <dl class="text-sm space-y-2">
            <div><dt class="text-slate-500 text-xs">N° conteneur</dt><dd class="text-slate-200 mono">@Model.ContainerNumber</dd></div>
            <div><dt class="text-slate-500 text-xs">N° booking / manifeste</dt><dd class="text-slate-200 mono">@Model.BookingReference</dd></div>
            <div><dt class="text-slate-500 text-xs">N° de scellé</dt><dd class="text-slate-200 mono">@Model.SealNumber @(Model.SealVerified ? "✓ vérifié conforme" : "")</dd></div>
            <div><dt class="text-slate-500 text-xs">Fouille</dt><dd class="text-slate-200">@(Model.Searched ? "Effectuée" : "Non effectuée")</dd></div>
            <div><dt class="text-slate-500 text-xs">Date/heure</dt><dd class="text-slate-200 mono">@Model.OccurredAt.ToString("dd/MM/yyyy HH:mm")</dd></div>
        </dl>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="border-t border-slate-700 pt-3 mt-3">
                <p class="text-sm text-slate-300 whitespace-pre-wrap">@Model.Notes</p>
            </div>
        }
    </div>
</div>
