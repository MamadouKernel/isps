@{
    ViewData["Title"] = "Documents PFSP";
    var docs = ViewBag.Documents as IReadOnlyList<SecurityDocument> ?? new List<SecurityDocument>();
    var dueReview = ViewBag.DueForReview as IReadOnlyList<SecurityDocument> ?? new List<SecurityDocument>();
    bool canEdit = User.IsInRole(DataSeeder.AdminRole) || User.IsInRole(DataSeeder.EditorRole);
    bool isAdmin = User.IsInRole(DataSeeder.AdminRole);
    string StatusClass(DocumentStatus s) => s switch
    {
        DocumentStatus.EnVigueur => "badge-vert",
        DocumentStatus.Brouillon => "badge-ambre",
        _ => "badge-bleu"
    };
}

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
    <div>
        <h1 class="text-xl sm:text-2xl font-bold text-white">📁 Documents de sûreté (PFSP & procédures)</h1>
        <p class="text-xs sm:text-sm text-slate-400">Gestion documentaire versionnée avec suivi de révision</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn-primary text-center w-full sm:w-auto">+ Ajouter un document</a>
    }
</div>

@if (dueReview.Count > 0)
{
    <div class="card p-4 mb-5 border-l-4 border-amber-500">
        <h3 class="font-semibold text-amber-400 text-sm uppercase mb-2">⏰ @dueReview.Count document(s) à réviser sous 30 jours</h3>
        <div class="flex flex-wrap gap-2">
            @foreach (var d in dueReview)
            {
                <span class="text-xs bg-amber-500/15 border border-amber-500/40 text-amber-300 px-2 py-1 rounded">@d.Title — @d.NextReviewDate?.ToString("dd/MM/yyyy")</span>
            }
        </div>
    </div>
}

<div class="card p-3 sm:p-4">
    @if (docs.Count == 0)
    {
        <p class="text-center text-slate-400 py-8">Aucun document enregistré.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="w-full text-sm">
                <thead class="text-xs uppercase text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="text-left p-2">Titre</th>
                        <th class="text-left p-2">Catégorie</th>
                        <th class="text-center p-2">Version</th>
                        <th class="text-left p-2 whitespace-nowrap">Révision</th>
                        <th class="text-center p-2">Statut</th>
                        <th class="text-right p-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in docs)
                    {
                        <tr class="border-b border-slate-800">
                            <td class="p-2">
                                <div class="text-slate-200">@d.Title @(d.IsConfidential ? "🔒" : "")</div>
                                <div class="text-xs text-slate-500">@d.Owner</div>
                            </td>
                            <td class="p-2 text-slate-400">@d.Category</td>
                            <td class="p-2 text-center mono text-cyan-300">v@d.Version</td>
                            <td class="p-2 mono text-slate-400 whitespace-nowrap">@(d.NextReviewDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="p-2 text-center"><span class="@StatusClass(d.Status) text-xs px-2 py-0.5 rounded">@d.Status</span></td>
                            <td class="p-2 text-right whitespace-nowrap">
                                <a asp-action="Details" asp-route-id="@d.Id" class="btn-secondary text-xs" title="Détails">👁️</a>
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@d.Id" class="btn-secondary text-xs" title="Modifier">✏️</a>
                                }
                                @if (!string.IsNullOrEmpty(d.FilePath))
                                {
                                    <a href="@d.FilePath" target="_blank" class="btn-secondary text-xs">📥 Ouvrir</a>
                                }
                                @if (canEdit && d.Status != DocumentStatus.EnVigueur)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <input type="hidden" name="status" value="@((int)DocumentStatus.EnVigueur)" />
                                        <button class="btn-primary text-xs">Mettre en vigueur</button>
                                    </form>
                                }
                                @if (isAdmin)
                                {
                                    @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel
                                    {
                                        Controller = "Documents",
                                        RouteValues = { ["id"] = d.Id.ToString() },
                                        ConfirmMessage = "Supprimer ?",
                                        ButtonLabel = "✕",
                                        ButtonClass = "btn-danger text-xs"
                                    })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
