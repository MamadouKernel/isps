@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Connexion";
    Layout = "_Layout";
    string logoUrl = "/images/logo.svg";
    foreach (var ext in new[] { ".jpeg", ".jpg", ".png", ".webp", ".svg" })
    {
        if (System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "logo" + ext)))
        { logoUrl = "/images/logo" + ext; break; }
    }
}

<div class="min-h-[80vh] flex items-center justify-center px-1">
    <div class="card p-6 sm:p-10 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="bg-white rounded-lg p-4 mx-auto inline-block shadow-md">
                <img src="@logoUrl" alt="Côte d'Ivoire Terminal" class="h-14 w-auto block" />
            </div>
            <div class="text-xs text-slate-400 mt-3 uppercase tracking-wider">Sûreté Portuaire — ISPS</div>
        </div>

        <form asp-action="Login" method="post" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

            <div>
                <label asp-for="Email" class="block text-sm text-slate-300 mb-1"></label>
                <input asp-for="Email" class="w-full" autocomplete="username" />
                <span asp-validation-for="Email"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm text-slate-300 mb-1"></label>
                <div class="relative">
                    <input asp-for="Password" type="password" class="w-full pr-10" autocomplete="current-password" id="password-input" />
                    <button type="button" id="toggle-password" aria-label="Afficher le mot de passe"
                            class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-400 hover:text-slate-200">
                        <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10 3.5c-4.4 0-8.2 2.9-9.5 6.5 1.3 3.6 5.1 6.5 9.5 6.5s8.2-2.9 9.5-6.5C18.2 6.4 14.4 3.5 10 3.5Zm0 11a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z" />
                        </svg>
                        <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2.7 2.3 1.3 3.7l2.9 2.9C2.6 7.7 1.3 9 .5 10.5c1.7 3.1 5.2 5.5 9.5 5.5 1.5 0 2.9-.3 4.2-.8l2.6 2.6 1.4-1.4L2.7 2.3ZM10 13.5a3.5 3.5 0 0 1-3.5-3.5c0-.5.1-1 .3-1.4l1.2 1.2a1.9 1.9 0 0 0 2.2 2.2l1.2 1.2c-.4.2-.9.3-1.4.3Zm-.3-6.8a1.9 1.9 0 0 1 2.1 2.1L9.7 6.7ZM10 4.5c1.5 0 2.9.3 4.2.8l-1.6 1.6a3.5 3.5 0 0 1 4.3 4.3l2 2c1-1 1.9-2.1 2.5-3.4C19.7 6.7 15.2 3.5 10 3.5c-.9 0-1.7.1-2.5.3l1.7 1.7c.3-.4.5 0 .8 0Z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-400">
                <input asp-for="RememberMe" type="checkbox" />
                <span>Se souvenir de moi</span>
            </label>

            <button type="submit" class="btn-primary w-full">Se connecter</button>
        </form>

        <div class="mt-6 pt-4 border-t border-slate-700 text-xs text-slate-500 text-center">
            CDC-ISPS-2026-001 · Accès réservé personnel autorisé
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            const input = document.getElementById('password-input');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            document.getElementById('eye-icon').classList.toggle('hidden', isPassword);
            document.getElementById('eye-off-icon').classList.toggle('hidden', !isPassword);
        });
    </script>
}
