@model Visitor
@{
    ViewData["Title"] = "Pré-enregistrer un visiteur";
}

<div class="mb-5">
    <h1 class="text-xl sm:text-2xl font-bold text-white">🛂 Pré-enregistrer un visiteur</h1>
    <p class="text-xs sm:text-sm text-slate-400">Référence générée automatiquement (VIS-année-numéro).</p>
</div>

<form asp-action="Create" method="post" class="card p-4 sm:p-6 space-y-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-red-400 text-sm"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label asp-for="FullName" class="block text-sm mb-1"></label><input asp-for="FullName" /></div>
        <div><label asp-for="Company" class="block text-sm mb-1"></label><input asp-for="Company" /></div>
        <div><label asp-for="IdDocumentNumber" class="block text-sm mb-1"></label><input asp-for="IdDocumentNumber" /></div>
        <div><label asp-for="Phone" class="block text-sm mb-1"></label><input asp-for="Phone" /></div>
        <div><label asp-for="VehiclePlate" class="block text-sm mb-1"></label><input asp-for="VehiclePlate" /></div>
        <div><label asp-for="Purpose" class="block text-sm mb-1"></label><input asp-for="Purpose" required /></div>
        <div><label asp-for="Host" class="block text-sm mb-1"></label><input asp-for="Host" /></div>
        <div><label asp-for="EscortedBy" class="block text-sm mb-1"></label><input asp-for="EscortedBy" /></div>
        <div><label asp-for="ScheduledArrival" class="block text-sm mb-1"></label><input asp-for="ScheduledArrival" type="datetime-local" required /></div>
        <div><label asp-for="ScheduledDeparture" class="block text-sm mb-1"></label><input asp-for="ScheduledDeparture" type="datetime-local" /></div>
        <div class="md:col-span-2"><label asp-for="Notes" class="block text-sm mb-1"></label><textarea asp-for="Notes" rows="2"></textarea></div>
    </div>

    <div class="flex flex-col sm:flex-row sm:justify-end gap-2 pt-2 border-t border-slate-700">
        <a asp-action="Index" class="btn-secondary text-center">Annuler</a>
        <button type="submit" class="btn-primary">✓ Pré-enregistrer</button>
    </div>
</form>
